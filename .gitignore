# Entornos virtuales
.venv/
venv/
env/
.env

# Datos pesados (se conserva la estructura de carpetas via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Editores
.vscode/
.idea/
.DS_Store

# Experiment tracking
mlruns/
wandb/

# OE2 robusto (outputs/oe2_robust/): artefactos intermedios pesados y
# regenerables por código (mu/logvar por semilla, scores crudos por
# conexión, curvas ROC por familia/semilla) -- no se versionan. Los CSV de
# tablas finales, JSON de métricas, figuras, checkpoints (pequeños, ~30KB
# c/u) y el informe SÍ se versionan.
outputs/oe2_robust/latent_vectors/
outputs/oe2_robust/tables/*.npz
outputs/oe2_robust/tables/_cache/

# VM Linux dedicada para OE2 robusto (scripts/run_oe2_robust_vm.sh) -- no
# se versiona, es local a cada máquina donde se corre el pipeline.
.venv-linux/
